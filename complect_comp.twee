:: StoryScript [script]
// Создаём глобальный аудиообъект, не привязанный к пассажу
window.bgm = new Audio("https://raw.githubusercontent.com/AnnaKarpina/novella_about_computer_arch/main/poslednyaya-glava-2-6835cb.mp3");
window.bgm.loop = true; // Бесконечное воспроизведение

// Пытаемся воспроизвести при первом взаимодействии с пользователем
// Примечание: этот обработчик сработает только один раз
document.addEventListener('click', function initAudio() {
    window.bgm.play().catch(function(err) {
        console.warn("Не удалось воспроизвести музыку:", err);
    });
    // Удаляем обработчик после успешного запуска, чтобы не срабатывал повторно
    document.removeEventListener('click', initAudio);
}, { once: true });

:: StoryStylesheet [stylesheet]
/* =========================================
   1. БАЗОВЫЕ НАСТРОЙКИ И ФОН
   ========================================= */
tw-story[tags~="my-tg1"] {
    background-image: url("https://raw.githubusercontent.com/AnnaKarpina/save_img/main/2_novell_fon.png");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
}











/* =========================================
   2. ПЕРСОНАЖИ
   ========================================= */
.character1 {
    position: fixed;
    bottom: 0vh;
    right: 5%;
    height: 95vh; /* было 85vh */
    z-index: 5;
    pointer-events: none; 
    
    animation: characterAppear 0.8s ease-out 1 both;
}











/* =========================================
   3. ДИАЛОГОВЫЕ ОКНА
   ========================================= */
/* _____________ ВАРИАНТ 1: Начальный пасаж и финальные_______ */
.dialog-first {
  padding: 12px 16px 10px;
  font-size: 15px;
  background: rgba(45, 38, 35, 0.92); 
  border: 1px solid #4a3e38;
  outline: 1px solid rgba(255, 255, 255, 0.05);
  outline-offset: -5px; 
  padding: 30px;
  border-radius: 4px;
  
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
    
  position: fixed;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%);
  
  width: clamp(320px, 90vw, 620px);
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
  
  color: #d6cdc5;
  font-family: "Courier New", Courier, monospace;
  padding: 20px 24px 18px;
  font-size: 25px;
}

/* Вместо полоски — эффект старой закладки */
.dialog-first::after {
  content: "";
  position: absolute;
  top: -2px; left: 30px;
  width: 15px;
  height: 35px;
  background: #8c3e3e; /* Тёмно-красная лента */
  box-shadow: 2px 2px 5px rgba(0,0,0,0.5);
  transform: rotate(2deg);
}





/* ---------- ВАРИАНТ 2: рассказчик---------- */
.dialog-modern1 {
  position: fixed;
  top: auto !important;       
  bottom: 5% !important;      
  left: 50% !important;
  transform: translateX(-50%); 
  z-index: 1000;
  
  border: none;
  background: rgba(13, 13, 18, 0.95);
  padding: 24px 28px 22px;
  border-radius: 8px;
  margin: 0;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
  overflow: hidden;
  
  width: clamp(1250px, 92vw, 1300px);
  min-height: 220px;
  box-sizing: border-box;
  
  font-size: clamp(26px, 1.5vw, 30px); 
  line-height: 1.6;
  color: #e0e0e0; 
}

.dialog-modern1::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #4a9eff, #00f0ff, #7a5cff);
}






/* ---------- ВАРИАНТ 3: Персонаж ---------- */
.dialog-modern-gradient {
  border: none;
  background: rgba(13, 13, 18, 0.95);
  
  padding: 45px 75px 30px 36px;
  border-radius: 8px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  
  overflow: visible; 

  position: fixed;
  top: auto !important;
  bottom: 5% !important;
  left: 50% !important;
  transform: translateX(-50%);
  margin: 0;
  z-index: 1000;
  
  width: clamp(1250px, 92vw, 1300px);
  min-height: 230px;
  box-sizing: border-box;
  
  font-size: clamp(26px, 1.5vw, 30px); 
  line-height: 1.6;
  color: #e0e0e0; 
}

/* Верхняя градиентная полоска */
.dialog-modern-gradient::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #4a9eff, #00f0ff, #7a5cff);
  border-radius: 8px 8px 0 0;
}

.dialog-modern-gradient::before {
  content: "ТЫ";
  position: absolute;
  top: 12px;
  left: 24px; 
  background: linear-gradient(90deg, #4a9eff, #00f0ff);
  color: #fff;
  font-size: 26px;      
  padding: 6px 18px;    
  font-weight: bold;
  border-radius: 6px;
  letter-spacing: 1.5px;
  z-index: 1;
  box-shadow: 0 4px 10px rgba(0, 240, 255, 0.3);
}





/* ---------- ВАРИАНТ 4: Подсказка ---------- */
.dialog-advise {
  padding: 12px 16px 10px;
  font-size: 15px;
  background: rgba(45, 38, 35, 0.92); 
  border: 1px solid #4a3e38;
  outline: 1px solid rgba(255, 255, 255, 0.05);
  outline-offset: -5px; 
  padding: 30px;
  border-radius: 4px;
  
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
    
  position: fixed;
  top: 20px !important;
  left: 20px !important;
  /* transform: translate(-50%, -50%);  ← УДАЛИТЬ эту строку */
  
  /* width можно оставить, но лучше ограничить, чтобы окно не растягивалось */
  width: clamp(320px, 90vw, 620px);
  max-height: 90vh;
  overflow-y: auto;
  box-sizing: border-box;
  
  color: #d6cdc5;
  font-family: "Courier New", Courier, monospace;
  padding: 20px 24px 18px;
  font-size: 25px;
}

/* Вместо полоски — эффект старой закладки */
.dialog-advise::after {
  content: "";
  position: absolute;
  top: -2px; left: 30px;
  width: 15px;
  height: 35px;
  background: #8c3e3e; /* Тёмно-красная лента */
  box-shadow: 2px 2px 5px rgba(0,0,0,0.5);
  transform: rotate(2deg);
}











/* =========================================
   4. ССЫЛКИ И ВЫБОРЫ (Кнопки)
   ========================================= */
tw-link, a, .enchantment-link {
  color: #4a9eff;
  text-decoration: none;
  font-weight: bold;
  transition: color 0.3s ease, text-shadow 0.3s ease, transform 0.2s ease;
  display: inline-block;
  cursor: pointer;
}

tw-link:hover, a:hover, .enchantment-link:hover {
  color: #00f0ff;
  text-shadow: 0 0 10px rgba(0, 240, 255, 0.8);
  transform: translateY(-2px); 
}

.dialog-modern-gradient tw-link::before,
.dialog-modern1 tw-link::before,
.dialog-modern-gradient a::before,
.dialog-modern1 a::before {
  content: "► "; 
  font-size: 0.8em;
  opacity: 0.7;
}
















/* =========================================
   5. АНИМАЦИИ (KEYFRAMES)
   ========================================= 
@keyframes fadeInCenter {
  from { opacity: 0; transform: translate(-50%, -50%) scale(0.95); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
}

@keyframes slideUpFade {
  from { opacity: 0; transform: translate(-50%, 30px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

@keyframes characterAppear {
  from { opacity: 0; transform: translateX(50px); }
  to { opacity: 1; transform: translateX(0); }
}
*/